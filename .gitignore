# Node
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-error.log*

# Environment, never commit real keys
.env
.env.*
!.env.example

# Rust and Cairo build output
target/
.snfoundry_cache/
# Scarb.lock is committed on purpose. Versions are pinned for the sprint.

# Next.js
.next/
out/
build/
.vercel

# TypeScript build output
dist/

# macOS
.DS_Store

# Credential files. Never commit any of these.
*credentials*.json
*-service-account*.json
*.pem
*.key

# Stray download artifacts. A failed fetch can write its error page to a
# file named after the platform it was requesting.
/arm64
/macOS

# Next.js
.next/
next-env.d.ts

# Bid backups. These hold claim_secret and a payout private key in plaintext.
# Committing one hands anyone the ability to move that bidder's collateral.
# The bid page downloads them to wherever the browser puts downloads, which
# can be the repository root.
sealed-bid-*.json
