{
  "name": "sealed-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vectors": "tsc -p tsconfig.scripts.json && node dist/scripts/check-vectors.js",
    "vectors:negative": "tsc -p tsconfig.scripts.json && SEALED_CORRUPT_VECTOR=1 node dist/scripts/check-vectors.js",
    "vectors:emit": "tsc -p tsconfig.scripts.json && node dist/scripts/emit-cairo-vectors.js",
    "payout": "tsx scripts/check-payout.ts",
    "create": "tsx scripts/check-create.ts",
    "discovery": "tsx scripts/check-discovery.ts",
    "vault": "tsx scripts/check-vault.ts",
    "backup:onchain": "tsx scripts/check-backup-onchain.ts"
  },
  "dependencies": {
    "@starknet-io/get-starknet-discovery": "^6.0.2",
    "@starknet-io/get-starknet-wallet-standard": "^6.0.2",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "starknet": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
